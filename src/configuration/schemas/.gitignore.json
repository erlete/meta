{
  "name": ".gitignore",
  "version": "3.1.0",
  "title": ".gitignore.meta",
  "description": "Metadata for composing .gitignore.",
  "license": "AGPL-3.0-only",
  "draft": "https://json-schema.org/draft/2020-12/schema",
  "domain": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "href": {
        "type": "string",
        "anyOf": [
          { "format": "uri" },
          { "pattern": "^(?:\\/|\\.{1,2}\\/|[A-Za-z]:\\\\).+" }
        ],
        "description": "URI or path to a base ignore template."
      },
      "custom": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Additional ignore patterns."
      }
    }
  }
}
