{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta.erlete.dev/core/meta/1.0.0.json",
  "title": "Distributed schemas base contract",
  "description": "Provenance and versioning for files in the versions archive (distributed files).",
  "type": "object",
  "required": ["$metadata", "title", "description", "$id"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "$id": { "type": "string", "format": "uri" },
    "$schema": { "type": "string", "format": "uri" },
    "$comment": { "type": "string" },
    "$metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "status",
        "authors",
        "created",
        "updated"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-.]+)?(?:\\+[0-9A-Za-z-.]+)?$"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "stable", "deprecated"]
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "owners": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string", "format": "uri" },
        "license": { "type": "string" },
        "created": { "type": "string", "format": "date-time" },
        "updated": { "type": "string", "format": "date-time" },
        "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "repo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "path": { "type": "string" },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{12}$" }
          }
        },
        "deprecated": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "since": { "type": "string", "format": "date-time" },
            "reason": { "type": "string" },
            "replacedBy": { "type": "string", "format": "uri" }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
